<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SI_RestoringMechanisms</defName>
    <label>restoring mechanisms</label>
    <description>Hidden mechanisms repair the psycaster's body after it has escaped combat. The system remains dormant shortly after the pawn takes damage.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="SignalInterceptor.HediffCompProperties_PsycasterRestoringMechanisms">
        <noDamageDelayTicks>600</noDamageDelayTicks>
        <intervalTicks>60</intervalTicks>
        <healAmount>0.70</healAmount>
        <bleedingHealMultiplier>1.45</bleedingHealMultiplier>
        <bloodLossReduction>0.012</bloodLossReduction>
        <onlyWhenNotRecentlyDamaged>true</onlyWhenNotRecentlyDamaged>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>SI_EntropyStabilizer</defName>
    <label>entropy stabilizer</label>
    <description>A psionic stabilizer that helps the psycaster recover neural heat after escaping combat.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="SignalInterceptor.HediffCompProperties_PsycasterEntropyStabilizer">
        <noDamageDelayTicks>0</noDamageDelayTicks>
        <intervalTicks>60</intervalTicks>
        <entropyReductionPerInterval>4.0</entropyReductionPerInterval>
      </li>
    </comps>
  </HediffDef>

</Defs>
