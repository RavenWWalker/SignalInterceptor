<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>SI_PsycasterSiteResonance</defName>
    <label>psychic resonance</label>
    <description>The anima tree resonates across this site, amplifying psychic sensitivity.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <statOffsets>
          <PsychicSensitivity>0.5</PsychicSensitivity>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>SI_PsycasterTreeShield</defName>
    <label>anima shield</label>
    <description>The anima tree is shielding this psycaster from hostile psychic interference.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <makesAlert>false</makesAlert>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1.0</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
  </HediffDef>

</Defs>
