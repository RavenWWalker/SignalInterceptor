<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FactionDef>
    <defName>SI_PsycasterVIPFaction</defName>
    <label>anomalous psycaster</label>
    <description>Not so much a faction as a temporary psychic presence formed around a distorted signal. It does not negotiate, establish settlements, or recognize territory. Each manifestation exists only briefly: it appears near the source of an anomaly, defends it with focused hostility, and vanishes once the signal collapses or its host is destroyed.</description>

    <factionNameMaker>NamerFactionPirate</factionNameMaker>

    <factionIconPath>World/WorldObjects/Sites/Beggars</factionIconPath>
    <settlementTexturePath>World/WorldObjects/Sites/Camp</settlementTexturePath>

    <!-- Хаки / желтовато-пыльные цвета, чтобы отличались от двойников -->
    <colorSpectrum>
      <li>(0.63, 0.58, 0.34)</li>
      <li>(0.74, 0.67, 0.38)</li>
      <li>(0.52, 0.55, 0.32)</li>
      <li>(0.82, 0.73, 0.46)</li>
    </colorSpectrum>

    <techLevel>Industrial</techLevel>

    <humanlikeFaction>true</humanlikeFaction>

    <canMakeRandomly>false</canMakeRandomly>
    <requiredCountAtGameStart>0</requiredCountAtGameStart>
    <maxCountAtGameStart>0</maxCountAtGameStart>

    <permanentEnemy>false</permanentEnemy>
    <hidden>false</hidden>

    <leaderTitle>leader</leaderTitle>
    <leaderTitleFemale>leader</leaderTitleFemale>

    <basicMemberKind>Colonist</basicMemberKind>

    <pawnSingular>psycaster</pawnSingular>
    <pawnsPlural>psycasters</pawnsPlural>

    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options>
          <Colonist>1</Colonist>
        </options>
      </li>
    </pawnGroupMakers>

    <backstoryCategories>
      <li>Outlander</li>
    </backstoryCategories>

    <maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0, 35)</li>
        <li>(70, 50)</li>
        <li>(300, 75)</li>
        <li>(700, 120)</li>
        <li>(1300, 180)</li>
        <li>(100000, 100000)</li>
      </points>
    </maxPawnCostPerTotalPointsCurve>

    <raidLootValueFromPointsCurve>
      <points>
        <li>(0, 0)</li>
        <li>(100, 0)</li>
        <li>(500, 0)</li>
        <li>(1000, 0)</li>
        <li>(5000, 0)</li>
      </points>
    </raidLootValueFromPointsCurve>

    <allowedArrivalTemperatureRange>-100~100</allowedArrivalTemperatureRange>
  </FactionDef>

</Defs>
