<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <SitePartDef>
    <defName>SI_PsycasterVIPSite</defName>
    <label>hostile psycaster</label>
    <description>A lone hostile psycaster hiding at the source of an intercepted signal.</description>

    <siteTexture>World/WorldObjects/Sites/Camp</siteTexture>
    <expandingIconTexture>World/WorldObjects/Sites/SI_Psycaster</expandingIconTexture>

    <approachOrderString>Confront the psycaster</approachOrderString>
    <approachingReportString>Approaching the hostile psycaster</approachingReportString>

    <wantsThreatPoints>false</wantsThreatPoints>
    <defaultHidden>false</defaultHidden>
    <WorkerClass>SitePartWorker_ConditionSpawner</WorkerClass> <!-- Если используешь ванильный спавнер -->
    
    <genStepDefs>
      <li>SI_PsycasterArenaGenStep</li> <!-- Ссылка на GenStepDef, который мы сейчас создадим -->
    </genStepDefs>
  </SitePartDef>

  <GenStepDef>
    <defName>SI_PsycasterArenaGenStep</defName>
    <linkWithSite>SI_PsycasterVIPSite</linkWithSite>
    <order>450</order> <!-- Порядок генерации (после базовой земли, но до спавна пешек) -->
    <genStep Class="SignalInterceptor.GenStep_PsycasterArena" />
  </GenStepDef>
</Defs>
